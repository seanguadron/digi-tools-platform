{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PICTURE Deck catalog",
  "type": "object",
  "required": [
    "tracks",
    "cards",
    "archetypes",
    "builder",
    "proofScenarios"
  ],
  "additionalProperties": false,
  "definitions": {
    "section": {
      "type": "string",
      "enum": [
        "protagonist",
        "illumination",
        "canvas",
        "tone",
        "universe",
        "references",
        "execution"
      ]
    },
    "trackId": {
      "type": "string",
      "enum": [
        "intensity"
      ]
    },
    "sectionTrackList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/trackId"
      }
    },
    "slotBudget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "grade": {
      "type": "object",
      "required": [
        "name",
        "description",
        "instruction"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "card": {
      "type": "object",
      "required": [
        "id",
        "code",
        "section",
        "driver",
        "goals",
        "grades"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,5}$"
        },
        "section": {
          "$ref": "#/definitions/section"
        },
        "driver": {
          "$ref": "#/definitions/trackId"
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "grades": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/definitions/grade"
          }
        },
        "affinity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "intensity": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              }
            }
          }
        }
      }
    },
    "trackValues": {
      "type": "object",
      "required": [
        "intensity"
      ],
      "additionalProperties": false,
      "properties": {
        "intensity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "partialTrackValues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "intensity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "equippedMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protagonist": {
          "$ref": "#/definitions/equippedList"
        },
        "illumination": {
          "$ref": "#/definitions/equippedList"
        },
        "canvas": {
          "$ref": "#/definitions/equippedList"
        },
        "tone": {
          "$ref": "#/definitions/equippedList"
        },
        "universe": {
          "$ref": "#/definitions/equippedList"
        },
        "references": {
          "$ref": "#/definitions/equippedList"
        },
        "execution": {
          "$ref": "#/definitions/equippedList"
        }
      }
    },
    "equippedList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "aspectRatioValue": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+$"
    },
    "mjTail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aspectRatio": {
          "$ref": "#/definitions/aspectRatioValue"
        },
        "stylize": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "chaos": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "weird": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "negative": {
          "type": "string"
        }
      }
    },
    "archetype": {
      "type": "object",
      "required": [
        "id",
        "code",
        "name",
        "description",
        "tracks",
        "equipped",
        "effects"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9]{2,5}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "tracks": {
          "$ref": "#/definitions/trackValues"
        },
        "equipped": {
          "$ref": "#/definitions/equippedMap"
        },
        "mjTail": {
          "$ref": "#/definitions/mjTail"
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "draft": {
      "type": "object",
      "required": [
        "subject",
        "negative",
        "mjTailEnabled",
        "aspectRatio",
        "stylize",
        "chaos",
        "weird"
      ],
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string"
        },
        "negative": {
          "type": "string"
        },
        "mjTailEnabled": {
          "type": "boolean"
        },
        "aspectRatio": {
          "$ref": "#/definitions/aspectRatioValue"
        },
        "stylize": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "chaos": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "weird": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "partialDraft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string"
        },
        "negative": {
          "type": "string"
        },
        "mjTailEnabled": {
          "type": "boolean"
        },
        "aspectRatio": {
          "$ref": "#/definitions/aspectRatioValue"
        },
        "stylize": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "chaos": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "weird": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "range": {
      "type": "object",
      "required": [
        "min",
        "max",
        "step",
        "fallback"
      ],
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        },
        "step": {
          "type": "integer",
          "minimum": 1
        },
        "fallback": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "scenario": {
      "type": "object",
      "required": [
        "id",
        "name",
        "proves",
        "panel",
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "proves": {
          "type": "string",
          "minLength": 1
        },
        "panel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "tracks": {
          "$ref": "#/definitions/partialTrackValues"
        },
        "equipped": {
          "$ref": "#/definitions/equippedMap"
        },
        "draft": {
          "$ref": "#/definitions/partialDraft"
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "properties": {
    "tracks": {
      "type": "object",
      "required": [
        "schemaVersion",
        "sectionTracks",
        "slotBudgets",
        "definitions",
        "defaultValues"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "sectionTracks": {
          "type": "object",
          "required": [
            "protagonist",
            "illumination",
            "canvas",
            "tone",
            "universe",
            "references",
            "execution"
          ],
          "additionalProperties": false,
          "properties": {
            "protagonist": {
              "$ref": "#/definitions/sectionTrackList"
            },
            "illumination": {
              "$ref": "#/definitions/sectionTrackList"
            },
            "canvas": {
              "$ref": "#/definitions/sectionTrackList"
            },
            "tone": {
              "$ref": "#/definitions/sectionTrackList"
            },
            "universe": {
              "$ref": "#/definitions/sectionTrackList"
            },
            "references": {
              "$ref": "#/definitions/sectionTrackList"
            },
            "execution": {
              "$ref": "#/definitions/sectionTrackList"
            }
          }
        },
        "slotBudgets": {
          "type": "object",
          "required": [
            "protagonist",
            "illumination",
            "canvas",
            "tone",
            "universe",
            "references",
            "execution"
          ],
          "additionalProperties": false,
          "properties": {
            "protagonist": {
              "$ref": "#/definitions/slotBudget"
            },
            "illumination": {
              "$ref": "#/definitions/slotBudget"
            },
            "canvas": {
              "$ref": "#/definitions/slotBudget"
            },
            "tone": {
              "$ref": "#/definitions/slotBudget"
            },
            "universe": {
              "$ref": "#/definitions/slotBudget"
            },
            "references": {
              "$ref": "#/definitions/slotBudget"
            },
            "execution": {
              "$ref": "#/definitions/slotBudget"
            }
          }
        },
        "definitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "description",
              "points"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/definitions/trackId"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "points": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "defaultValues": {
          "$ref": "#/definitions/trackValues"
        }
      }
    },
    "cards": {
      "type": "object",
      "required": [
        "schemaVersion",
        "cards"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "cards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/card"
          }
        }
      }
    },
    "archetypes": {
      "type": "object",
      "required": [
        "schemaVersion",
        "archetypes"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "archetypes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/archetype"
          }
        }
      }
    },
    "builder": {
      "type": "object",
      "required": [
        "schemaVersion",
        "emptyDraft",
        "exampleDraft",
        "pictureParts",
        "requiredFields",
        "aspectRatios",
        "stylizeRange",
        "chaosRange",
        "weirdRange"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "emptyDraft": {
          "$ref": "#/definitions/draft"
        },
        "exampleDraft": {
          "$ref": "#/definitions/draft"
        },
        "pictureParts": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "required": [
              "letter",
              "label",
              "summary"
            ],
            "additionalProperties": false,
            "properties": {
              "letter": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "requiredFields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "label",
              "field"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "type": "string",
                "enum": [
                  "subject"
                ]
              }
            }
          }
        },
        "aspectRatios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "$ref": "#/definitions/aspectRatioValue"
              }
            }
          }
        },
        "stylizeRange": {
          "$ref": "#/definitions/range"
        },
        "chaosRange": {
          "$ref": "#/definitions/range"
        },
        "weirdRange": {
          "$ref": "#/definitions/range"
        }
      }
    },
    "proofScenarios": {
      "type": "object",
      "required": [
        "schemaVersion",
        "baseDraft",
        "scenarios"
      ],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "baseDraft": {
          "$ref": "#/definitions/partialDraft"
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/scenario"
          }
        }
      }
    }
  }
}
