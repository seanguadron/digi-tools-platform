  "definitions": [
    {
      "id": "contextDepth",
      "label": "Context depth",
      "description": "How much background and constraint detail the prompt carries.",
      "points": [
        "Brief",
        "Grounded",
        "Detailed",
        "Comprehensive"
      ]
    },
    {
      "id": "evidenceRigor",
      "label": "Evidence rigor",
      "description": "How strongly the model must verify and qualify its evidence.",
      "points": [
        "Informal",
        "Supported",
        "Corroborated",
        "Auditable"
      ]
    },
    {
      "id": "autonomy",
      "label": "Autonomy",
      "description": "How independently the model may plan and complete the work.",
      "points": [
        "Guided",
        "Collaborative",
        "Independent",
        "Agentic"
      ]
    },
    {
      "id": "practicality",
      "label": "Practicality",
      "description": "How strongly the work should favor immediate application.",
      "points": [
        "Exploratory",
        "Applied",
        "Execution-ready"
      ]
    },
    {
      "id": "challenge",
      "label": "Challenge",
      "description": "How aggressively the model should test assumptions and claims.",
      "points": [
        "Supportive",
        "Questioning",
        "Critical",
        "Adversarial"
      ]
    },
    {
      "id": "outputDetail",
      "label": "Output detail",
      "description": "How much explanation and supporting material the artifact includes.",
      "points": [
        "Lean",
        "Concise",
        "Detailed",
        "Exhaustive"
      ]
    },
    {
      "id": "structure",
      "label": "Structure",
      "description": "How strictly the response must follow an explicit organization.",
      "points": [
        "Flexible",
        "Guided",
        "Structured",
        "Strict"
      ]
    },
    {
      "id": "audienceExpertise",
      "label": "Audience expertise",
      "description": "How much domain knowledge the response may assume.",
      "points": [
        "Newcomer",
        "Beginner",
        "Working knowledge",
        "Advanced",
        "Expert"
      ]
    },
    {
      "id": "voiceFormality",
      "label": "Voice formality",
      "description": "How formal the response should sound without changing its intent.",
      "points": [
        "Conversational",
        "Neutral",
        "Professional",
        "Formal"
      ]
    }
  ],
