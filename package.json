{
  "name": "digi-tools",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 5100",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && next dev -p 5100",
    "prebuild": "npm run data:validate && npm run check:standards && npm run check:security",
    "build": "next build",
    "start": "next start -p 5100",
    "lint": "eslint src scripts next.config.ts",
    "typecheck": "tsc --noEmit",
    "data:generate": "node scripts/generate-prompt-role-docs.mjs && node scripts/generate-craft-art-docs.mjs && node scripts/generate-picture-art-docs.mjs",
    "data:validate": "node scripts/validate-prompt-data.mjs && node scripts/validate-picture-data.mjs",
    "data:test": "node --test scripts/prompt-data.test.mjs scripts/picture-data.test.mjs",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/*.test.mjs",
    "check:standards": "node scripts/check-standards.mjs",
    "check:security": "node scripts/check-security.mjs",
    "gate:sweep": "node scripts/gate-sweep.mjs",
    "amendments": "node scripts/pending-amendments.mjs",
    "skill:log": "node scripts/log-skill.mjs",
    "prepare": "git config core.hooksPath .githooks || echo \"hooks: skipped\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@xyflow/react": "^12.11.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "ajv": "^8.17.1",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "4.3.1",
    "typescript": "5.9.3"
  }
}
